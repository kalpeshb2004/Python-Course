# 1. Count Windows With Given Sum
# Size k ki kitni windows ka sum exactly target ke barabar hai, gino.
# Input: [1,2,3,4,2,1,3], k=3, target=9 → Output: 2

def count_sum(arr,k,target):
    n = len(arr)
    if n < k:
        return 0

    count = 0
    window_sum = sum(arr[:k])
    if window_sum == target:
        count += 1

    for i in range(k,n):
        window_sum += arr[i] - arr[i-k]
        if window_sum == target:
            count += 1
    return count

print(count_sum([1,2,3,4,2,1,3],3,9))

# 2. Diet Plan Performance (LeetCode 1176)
# Size k ki har window ke calories ka sum lo. Sum lower se kam ho to -1 point, upper se zyada ho to +1 point, beech me ho to 0. Total points batao.
# Input: calories=[1,2,3,4,5], k=1, lower=3, upper=3 → Output: 0

def diet_plan(arr,k,lower,upper):
    n = len(arr)
    if n < k:
        return 0

    count = 0
    window_sum = sum(arr[:k])
    if window_sum < lower:
        count -= 1
    if window_sum > upper:
        count += 1

    for i in range(k,n):
        window_sum += arr[i] - arr[i-k]
        if window_sum < lower:
            count -= 1
        if window_sum > upper:
            count += 1
    return count

print(diet_plan([1,2,3,4,5],1,3,3))

