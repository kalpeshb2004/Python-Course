# 1. Max Sum Subarray of Size K
# Size K ki sabhi continuous windows me se sabse bada sum dhundo.
# Input: [2,1,5,1,3,2], k=3 → Output: 9

def max_sum_subarray(arr,k):
    n = len(arr)
    if n < k:
        return 0

    window_sum = sum(arr[:k])
    max_sum = window_sum

    for i in range(k,n):
        window_sum += arr[i] - arr[i-k]
        max_sum = max(max_sum,window_sum)

    return max_sum

print(max_sum_subarray([2,1,5,1,3,2],3)) 


# 2. Min Sum Subarray of Size K
# Same template, bas max ki jagah min use hoga.
# Input: [4,2,1,7,8,1,2,8,1,0], k=3 → Output: 7

def min_sum_subarr(arr,k):
    n = len(arr)
    if n < k:
        return 0

    window_sum = sum(arr[:k])
    min_sum = window_sum

    for i in range(k,n):
        window_sum += arr[i] - arr[i-k]
        min_sum = min(min_sum,window_sum)

    return min_sum

print(min_sum_subarr([4,2,1,7,8,1,2,8,1,0],3))


# 3. Average of All Subarrays of Size K
# Har window ka average nikal ke list me daalo.
# Input: [1,3,2,6,-1,4,1,8,2], k=5 → Output: [2.2, 2.8, 2.4, 3.6, 2.8]

def avg_arr(arr,k):
    n = len(arr)
    if n < k:
        return 0

    window_sum = sum(arr[:k])
    result = [ window_sum/k ]

    for i in range(k,n):
        window_sum += arr[i] - arr[i-k]
        result.append( window_sum/k )

    return result

print(avg_arr([1,3,2,6,-1,4,1,8,2],5))

# **4. Maximum Average Subarray (LeetCode 643)**
# Size K ki window jiska average sabse bada ho, woh average return karo.
# Input: `[1,12,-5,-6,50,3]`, k=4 → Output: `12.75`

def max_avg_array(arr,k):
    n = len(arr)
    if n < k:
        return 0

    window_sum = sum(arr[:k])
    max_avg = window_sum / k
    
    for i in range(k,n):
        window_sum += arr[i] - arr[i-k]
        max_avg = max(max_avg,window_sum/k)

    return max_avg

print(max_avg_array([1,12,-5,-6,50,3],4))

